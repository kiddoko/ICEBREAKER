{
  "name": "icebreaker",
  "private": true,
  "version": "0.1.0",
  "description": "ICEBREAKER — an open-source, terminal-styled cyberdeck for notes, journaling and AI-powered plugins.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "app:mac": "tauri build --bundles app && sh scripts/mac-dev-sign.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@xterm/headless": "^6.0.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
